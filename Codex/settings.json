{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Program Files/Git/bin/sh.exe\" \"$CLAUDE_PROJECT_DIR/Codex/hooks/block_dangerous_commands.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Program Files/Git/bin/sh.exe\" \"$CLAUDE_PROJECT_DIR/Codex/hooks/guard_secret_leak.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Program Files/Git/bin/sh.exe\" \"$CLAUDE_PROJECT_DIR/Codex/hooks/validate_csharp_conventions.sh\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Program Files/Git/bin/sh.exe\" \"$CLAUDE_PROJECT_DIR/Codex/hooks/log_activity.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Program Files/Git/bin/sh.exe\" \"$CLAUDE_PROJECT_DIR/Codex/hooks/session_summary.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Program Files/Git/bin/sh.exe\" \"$CLAUDE_PROJECT_DIR/Codex/hooks/inject_context.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
