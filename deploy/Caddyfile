{
	admin off
}

(wildlife_proxy) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy app:8080 {
		header_up X-Forwarded-Proto https
	}
}

# Loopback-only health endpoint published by Compose on 127.0.0.1:18080.
http://:8080 {
	import wildlife_proxy
}

# Public endpoint. Caddy obtains and renews the TLS certificate automatically.
{$APP_DOMAIN} {
	import wildlife_proxy
}
